# ============================================
# Production Environment Configuration for VPS
# ============================================

# Security
# Run `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"` on server to generate a unique key
DJANGO_SECRET_KEY=generate_a_strong_unique_secret_key_here

# ALWAYS False in Production!
DJANGO_DEBUG=False

# Allowed Domains (comma separated)
DJANGO_ALLOWED_HOSTS=pickpickles.xyz,www.pickpickles.xyz,127.0.0.1,localhost

# Timezone & Localization
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_LANGUAGE_CODE=en-us

# ============================================
# WhatsApp Order Notifications
# ============================================
# Your Admin WhatsApp Number
WHATSAPP_ADMIN_PHONE=01739804566

# CallMeBot Personal Notification API Key:
WHATSAPP_CALLMEBOT_API_KEY=

# UltraMsg (Alternative Gateway):
WHATSAPP_ULTRAMSG_INSTANCE_ID=
WHATSAPP_ULTRAMSG_TOKEN=

# ============================================
# Meta / Facebook Pixel Tracking
# ============================================
META_PIXEL_ID=2165451210680943
