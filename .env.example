# Pickpickles Bangladesh Production Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=pickpickles-production-secret-key-change-this-in-live
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=pickpickles.xyz,www.pickpickles.xyz,127.0.0.1,localhost

# PostgreSQL Database Configuration (aaPanel)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pickpickles_db
DB_USER=pickpickles_user
DB_PASSWORD=your_secure_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Facebook / Meta Pixel ID
META_PIXEL_ID=2165451210680943

# Pathao Courier Merchant Developer API Credentials
# Set PATHAO_BASE_URL to https://courier-api-sandbox.pathao.com for sandbox testing
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_registered_email_or_phone
PATHAO_PASSWORD=your_pathao_password
PATHAO_STORE_ID=446187
