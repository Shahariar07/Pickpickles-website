# ==============================================================================
# PickPickles Django Environment Configuration (Example Template)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-django-secret-key-here
DJANGO_ALLOWED_HOSTS=pickpickles.xyz,www.pickpickles.xyz,127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Dhaka
DJANGO_LANGUAGE_CODE=en-us

# ------------------------------------------------------------------------------
# 2. Database Settings (PostgreSQL Production)
# ------------------------------------------------------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pickpickles_db
DB_USER=pickpickles_user
DB_PASSWORD=your_db_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# ------------------------------------------------------------------------------
# 3. Analytics & Pixel Tracking
# ------------------------------------------------------------------------------
META_PIXEL_ID=your_meta_pixel_id
GOOGLE_ANALYTICS_ID=your_google_analytics_id

# ------------------------------------------------------------------------------
# 4. Pathao Courier Merchant API Credentials
# ------------------------------------------------------------------------------
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=your_pathao_client_id
PATHAO_CLIENT_SECRET=your_pathao_client_secret
PATHAO_USERNAME=your_pathao_username
PATHAO_PASSWORD=your_pathao_password
PATHAO_STORE_ID=your_pathao_store_id

# ------------------------------------------------------------------------------
# 5. Steadfast Courier Merchant API Credentials
# ------------------------------------------------------------------------------
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key

# ------------------------------------------------------------------------------
# 6. Cloudflare Turnstile Bot Protection (Anti-Spam / Anti-Fraud)
# ------------------------------------------------------------------------------
CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ------------------------------------------------------------------------------
# 7. Security & SSL (When domain has SSL enabled)
# ------------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
